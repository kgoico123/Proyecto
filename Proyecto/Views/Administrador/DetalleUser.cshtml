@model Proyecto.ViewModels.UserDetailVM
@using Proyecto.shared
@using Proyecto.Models
@{
    ViewData["Title"] = "Detalle de Usuario";
}

<div class="min-h-screen p-4 sm:p-8">
    <div class="max-w-5xl mx-auto">
        <div class="mb-4">
             <a asp-action="Usuarios" asp-controller="Administrador" class="inline-flex items-center px-4 py-2 bg-white text-gray-700 text-sm font-medium rounded-md hover:bg-gray-50 border border-gray-300 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Volver a la lista
            </a>
        </div>
        @await Html.PartialAsync("_UserDetailsPartial", Model)
    </div>
</div>
